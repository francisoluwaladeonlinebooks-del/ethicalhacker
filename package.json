{
  "name": "ficap",
  "version": "1.0.0",
  "private": true,
  "description": "FICAP — Financial Institution Cybersecurity Assurance Platform (CBN supervisory application security assessment)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/cvss4.test.ts tests/scope.test.ts tests/rbac.test.ts",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@pandatix/js-cvss": "0.4.4",
    "cvss4": "1.0.7",
    "exceljs": "4.4.0",
    "next": "15.5.28",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
