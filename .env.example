# ---------------------------------------------------------------------------
# FICAP configuration (all values are optional in demo mode)
# ---------------------------------------------------------------------------
# Platform mode: "demo" (synthetic training range only) or "live"
FICAP_MODE=demo

# 32-byte key material used to encrypt evidence blobs, TOTP secrets and artifacts at rest.
# Generate with: openssl rand -base64 48
FICAP_ENCRYPTION_KEY=

# Session signing / token pepper (independent from the encryption key)
FICAP_SESSION_PEPPER=

# Where the embedded PostgreSQL (PGlite) data directory lives
FICAP_DATA_DIR=.data/pglite

# Assessment worker: enable the in-process job runner
FICAP_WORKER_ENABLED=true

# Absolute base URL used for links in generated reports
FICAP_BASE_URL=http://127.0.0.1:3000

# Optional AI analyst provider (OpenAI-compatible chat completion endpoint).
# Leave empty to use the offline deterministic rules analyst only.
FICAP_AI_ENDPOINT=
FICAP_AI_MODEL=
FICAP_AI_API_KEY=

# Optional OSV vulnerability intelligence endpoint (defaults to the public OSV API).
FICAP_OSV_ENDPOINT=https://api.osv.dev/v1/querybatch

# Emit Strict-Transport-Security. Only enable when this deployment terminates TLS
# for the whole domain (and its subdomains) that serves the platform.
FICAP_ENABLE_HSTS=0
